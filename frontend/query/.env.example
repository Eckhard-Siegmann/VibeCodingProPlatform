# OS-Cron tick endpoint authentication (ADR 010)
# The Hetzner cron job sends this token as Bearer auth to POST /api/internal/tick
# Generate a strong random token for production: openssl rand -hex 32
CRON_BEARER_TOKEN=dev-cron-token-change-in-production

# OAuth providers (ADR 004)
# GitHub: Create OAuth App at https://github.com/settings/developers
# Callback URL: {ORIGIN}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn: Create App at https://www.linkedin.com/developers/
# Callback URL: {ORIGIN}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Brevo transactional email (ADR 005)
# Create API key at https://app.brevo.com/settings/keys/api
# When BREVO_API_KEY is empty, all emails log to console (dev mode).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@vibecoding.events
BREVO_SENDER_NAME=VibeCoding Community

# Brevo template IDs — create these in the Brevo dashboard
# See ADR 005 for required template variables per template.
BREVO_TEMPLATE_EMAIL_CONFIRMATION=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_ONBOARDING_OTP=
BREVO_TEMPLATE_EVENT_GENERIC=

# Platform base URL (used for building email links)
# In production: https://vibecoding.events
ORIGIN=http://localhost:5173
